{
  "expo": {
    "name": "Siddheswari CampusHub",
    "slug": "campushub-mobile",
    "scheme": "campushub",
    "platforms": [
      "android",
      "ios"
    ],
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.campushub.mobile"
    },
    "extra": {
      "portalUrl": "https://example.edu"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
